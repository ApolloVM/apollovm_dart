pubspec_overrides.yaml

# Test coverage output (generated by `dart test --coverage`).
coverage/

# VS Code LSP extension build artifacts (nested Node project).
lsp/vscode/node_modules/
lsp/vscode/package-lock.json
lsp/vscode/*.vsix
